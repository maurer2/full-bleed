{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "singleAttributePerLine": true,
  "svelte": true,
  "sortImports": {
    // React first, in its own block at the top
    "customGroups": [
      {
        "groupName": "svelte",
        "elementNamePattern": ["svelte", "svelte/*"]
      }
    ],
    "groups": [
      "svelte",
      {
        "newlinesBetween": false
      },
      ["builtin", "external"],
      ["subpath", "internal", "parent"],
      ["sibling"],
      ["index"],
      "unknown"
    ]
  },
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortTailwindcss": {
    "stylesheet": "./src/app.css",
    "functions": ["clsx"],
    "attributes": ["className"],
    "preserveWhitespace": false
  },
  "ignorePatterns": [
    "__mocks__/**",
    "coverage/**",
    "dist/**",
    "**/*.gen.ts",
    "index.html",
    "public/**",
    "pnpm-lock.yaml",
    "README.md"
  ],
  // Workaround for the JSON formatting mismatch between the VS Code extension and the npm script: https://github.com/oxc-project/oxc-vscode/issues/140
  "overrides": [
    {
      "files": ["**/*.json", "**/*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
